DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret

# Bot owner — always has dashboard access regardless of Discord permissions
OWNER_ID=your_discord_user_id

# Primary guild ID
GUILD_ID=your_guild_id

# Documents channel — moderation evidence collection
DOCUMENTS_CHANNEL_ID=

# Staff break requests
BREAK_REQUEST_CHANNEL_ID=your_break_request_channel_id
ON_BREAK_ROLE_ID=optional_role_id_assigned_during_staff_break

# PBAN
PBAN_PROPOSAL_CHANNEL_ID=your_pban_proposal_channel_id
PBAN_LOG_CHANNEL_ID=your_pban_log_channel_id
PBAN_PROTECTED_ROLE_IDS=your_protected_role_ids
PBAN_APPEALS_INVITE=https://discord.gg/your-appeal-server

# Anti-bot automod
ANTI_BOT_AUTOMOD_CHANNEL_ID=your_automod_channel_id

# Bot appearance (also configurable via wizard / dashboard)
BOT_STYLE_COLOR=0xc67a3a
BOT_TITLE_PREFIX=
BOT_FOOTER=Hallows

# Web Dashboard
DASHBOARD_PORT=3000
DASHBOARD_SESSION_SECRET=your_random_session_secret
DASHBOARD_NOTIFY_CHANNEL=optional_channel_id_for_dashboard_notifications

# Logging
LOG_LEVEL=info

# Staff hierarchy config
ROLE_POLICY_FILE=./role-policy.json
