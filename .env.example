DISCORD_TOKEN=your_discord_bot_token
GUILD_ID=your_guild_id

SUPPORT_PANEL_CHANNEL_ID=your_support_panel_channel_id
SUPPORT_PANEL_BUTTON_ID=modmail_open_ticket
SUPPORT_PANEL_CONTENT="# dm me for support!\nyou can dm me or click the button below for support regarding partnerships, general support, user reporting, HR, or internals!"

# Optional extra legacy role added by /approve after Assistant rank 1.
APPROVED_APPLICANT_ROLE_ID=
APPROVE_GHOST_PING_CHANNEL_ID=your_approve_ghost_ping_channel_id
APPROVE_DM_MESSAGE="Hello <user>. Thank you for applying for staff. Upon reviewing your application we are happy to let you know that we have decided to move forward with you. You have been accepted onto the staff team. Please review the staff handbook and introduce yourself to the staff team. Thank you for your time."
REJECT_DM_MESSAGE="Hello. Thank you for applying for staff. Upon reviewing your application we unfortunately decided to not move forward with you as of this time. Your application has been cleared and you are free to try again with a new application whenever you wish to. Thank you for your time."

# Local file paths
STATE_FILE=./data/modmail-state.json
ROLE_POLICY_FILE=./role-policy.json
TICKET_BRANCH_POLICY_FILE=./ticket-branch-policy.json
MODMAIL_COMMAND_POLICY_FILE=./modmail-command-policy.json
REVIEWER_STATE_FILE=./data/app-review-state.json
TIMED_CLOSE_STATE_FILE=./data/ticket-close-timers.json
BREAK_STATE_FILE=./data/staff-breaks.json
PARTNERSHIP_AD_FILE=./partnership-ad.txt
PARTNERSHIP_AD_INTRO_FILE=./partnership-ad-intro.txt
TIMED_CLOSE_MESSAGE_FILE=./timed-close-message.txt
REPORT_FINISHED_MESSAGE_FILE=./report-finished-message.txt
SAVED_SNIPPETS_FILE=./saved-snippets.json
COMMANDS_FILE=./commands.json

# Staff break requests
BREAK_REQUEST_CHANNEL_ID=your_break_request_channel_id

# Bot display
BOT_STYLE_COLOR=0xffb7c5
BOT_TITLE_PREFIX=ModMail
BOT_FOOTER=ModMail

# Google Form application reviewer
DISCORD_CHANNEL_ID=your_application_channel_id
GOOGLE_FORM_ID=your_google_form_id
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_AUTH_PORT=3000
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=5000
POLL_INTERVAL_SECONDS=30
APPLICATION_POST_DELAY_SECONDS=15
PROCESS_EXISTING_RESPONSES=false
THREAD_AUTO_ARCHIVE_MINUTES=1440

# Wing category IDs
ASSISTANTS_CATEGORY_ID=your_assistants_category_id
PARTNERSHIP_CATEGORY_ID=your_partnership_category_id
REPORT_CATEGORY_ID=your_moderation_category_id
HR_CATEGORY_ID=your_hr_category_id
INTERNALS_CATEGORY_ID=your_internals_category_id

# Legacy category fallbacks still supported by code
GENERAL_CATEGORY_ID=
STAFF_APPLICATION_CATEGORY_ID=

# Optional channel where closed-ticket summaries are posted.
# If blank, the transcript is posted in the ticket before deletion.
TRANSCRIPT_CHANNEL_ID=
